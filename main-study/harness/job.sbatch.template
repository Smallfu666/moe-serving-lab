#!/usr/bin/env bash
#SBATCH --job-name=msl-<arm>
#SBATCH --gres=gpu:<gpu-type>:<n>
#SBATCH --time=<hh:mm:ss>
#SBATCH --mem=<200G for 1 GPU, 400G for 2>
#SBATCH --output=<log-dir>/%j.out
#SBATCH --error=<log-dir>/%j.err
# Submit from a neutral directory: sbatch --chdir=<log-dir> --exclude="$MSL_EXCLUDE_NODES" job.sbatch
# SBATCH_ACCOUNT and SBATCH_PARTITION are read from the environment (see env.example.sh).
set -uo pipefail
source "<deployed-env.sh>"
mkdir -p "$TRITON_CACHE_DIR" "$TORCHINDUCTOR_CACHE_DIR" "$XDG_CACHE_HOME" "$FLASHINFER_WORKSPACE_BASE" \
  "$SGLANG_CACHE_DIR" "$TMPDIR"
OUT="$MSL_ROOT/runs/$SLURM_JOB_ID"
mkdir -p "$OUT"

bash "$MSL_HARNESS/run_arm.sh" <arm-tag> <model-dir> <GB200|H200> "<phases>" "$OUT/<arm-tag>"
rc=$?
printf '{"job": "%s", "exit_status": %d, "elapsed_s": %d}\n' "$SLURM_JOB_ID" "$rc" "$SECONDS" > "$OUT/marker.json"
exit "$rc"
